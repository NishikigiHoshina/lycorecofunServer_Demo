<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lycorisfun.fun.Mapper.NewsMapper">

    <select id="findAll" resultType="News">
        select * from news
    </select>

    <select id="findById" parameterType="Integer" resultType="News">
        select * from news where news_id=#{news_id}
    </select>


    <!-- 新建新闻：news_id 自增不插入；status 缺省由实体默认/服务兜底为 1 -->
    <insert id="add" parameterType="News" useGeneratedKeys="true" keyProperty="news_id">
        insert into news(title,imgUrl,news_link,time,status)
        values (#{title},#{imgurl},#{news_link},#{time},#{status})
    </insert>

    <select id="findByTitle" parameterType="String" resultType="News">
        SELECT *
        FROM news
        WHERE title LIKE CONCAT('%', #{title}, '%')
    </select>

    <select id="findBytime" parameterType="String" resultType="News">
        SELECT *
        FROM news
        WHERE created_at LIKE CONCAT('%', #{title}, '%')
    </select>

    <select id="findAllNews" resultType="News">
        SELECT *
        FROM news
        WHERE imgUrl is not null
    </select>

    <select id="findLatestNews" parameterType="Integer" resultType="News">
        select *
        from news
        where imgUrl is not null AND status = 1              -- 仅展示未软删除(status=1)
        ORDER BY time DESC                                   -- 按日期最新在前
        LIMIT #{findnum}
    </select>

    <!-- 公告 = news 表中 imgUrl 为 NULL 的那条，正文寄存在 news_link 列。
         limit 1：数据异常存在多条时取一条返回，避免 selectOne 抛 TooManyResults 变 500 -->
    <select id="findAnnouncement" resultType="News">
        select * from news where imgUrl is null limit 1
    </select>

    <!-- 公告更新：把正文写到 news_link；无公告行时由 Service 走新增 -->
    <update id="updateAnnouncement">
        UPDATE news
        SET    news_link = #{text}
        WHERE  imgUrl is null
    </update>

    <!-- 是否存在公告行：用于 update-or-insert 判断 -->
    <select id="countAnnouncement" resultType="int">
        select count(*) from news where imgUrl is null
    </select>

    <!-- 软删除：status 1(显示) -> 0(已删除) -->
    <update id="delbyid" parameterType="Integer">
        UPDATE news
        SET    status = 0
        WHERE  news_id = #{news_id}
    </update>

    <!-- 编辑：String 缺省保留原值；status 恒更新（对话框总是带当前状态，可用于恢复 status=1） -->
    <update id="updateNewsInfo" parameterType="News">
        UPDATE news
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="imgurl != null">imgUrl = #{imgurl},</if>
            <if test="news_link != null">news_link = #{news_link},</if>
            <if test="time != null">time = #{time},</if>
            status = #{status}
        </set>
        WHERE news_id = #{news_id}
    </update>

</mapper>